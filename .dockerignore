# Keep the build context small and, more importantly, keep secrets out of
# the image. Every COPY in the Dockerfile is filtered by this file, so an
# omission here is how credentials end up baked into a layer that anyone
# who pulls the image can extract with `docker history`.

# --- secrets: never in an image -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
secrets.yml
secrets.yaml

# --- virtualenvs: platform-specific, rebuilt in the image ---------------
venv/
.venv/
env/
ENV/

# --- python bytecode and caches -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- version control and editors ----------------------------------------
.git/
.gitignore
.gitattributes
.github/
.idea/
.vscode/
*.swp
*~
.DS_Store

# --- local databases and dumps ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump

# --- UAT artefacts: useful locally, noise in an image -------------------
uat_nfl_report.md
uat_barrage_report.md
leaderboard_check.txt
keycheck.txt
brady_diff.txt
career_truth.txt
damage.txt
*.log

# --- container and orchestration files ----------------------------------
Dockerfile
.dockerignore
docker-compose*.yml
k8s/
terraform/
ansible/

# --- docs and binaries that do not belong in a runtime image ------------
README.md
*.md
!requirements*.txt
*.pptx
*.xlsx
*.pdf
*.zip
